# Jenkins REST API — copy to .env (git-ignored)
JENKINS_URL=https://jenkins.example.com
JENKINS_USER=
# User -> Configure -> API Token -> Add new token (khuyên dùng, không cần CSRF crumb)
JENKINS_API_TOKEN=
# Hoặc mật khẩu nếu chưa có token
JENKINS_PASSWORD=
# View mặc định cho lệnh `jobs`
JENKINS_DEFAULT_VIEW=CCDT-DEV
# true nếu Jenkins chạy HTTPS chứng chỉ tự ký
JENKINS_INSECURE=false
# Regex tên job deploy lên môi trường tắt Flyway (phải chạy SQL tay); build sẽ in lời nhắc
JENKINS_MANUAL_SQL_JOBS=(^|_)PROD(_|$)
