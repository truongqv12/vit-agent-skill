# ==============================================================================
# CẤU HÌNH JIRA VNPT (HỖ TRỢ PAT HOẶC USERNAME/PASSWORD HOẶC COOKIE)
# ==============================================================================
JIRA_BASE_URL=https://cntt.vnpt.vn

# 1. Khuyên dùng: Personal Access Token (PAT) - Không bao giờ bị hỏi OTP/SMS
# Tạo tại: https://cntt.vnpt.vn/plugins/servlet/personal-access-tokens
JIRA_PAT=

# 2. Đăng nhập bằng Username / Password (Có thể yêu cầu OTP nếu MFA được bật)
JIRA_USERNAME=tttruong
JIRA_PASSWORD=

# 3. Hoặc dùng Session Cookie JSESSIONID từ trình duyệt
JIRA_COOKIE=

# Bỏ qua cảnh báo chứng chỉ SSL nội bộ
IGNORE_SSL_WARNINGS=true
