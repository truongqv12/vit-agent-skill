# ==============================================================================
# CẤU HÌNH JIRA VNPT (HỖ TRỢ COOKIE, PAT HOẶC USERNAME/PASSWORD)
# ==============================================================================
JIRA_BASE_URL=https://cntt.vnpt.vn

# 1. Khuyên dùng cho Jira VNPT (MFA): Session Cookie JSESSIONID từ trình duyệt
# Lấy từ F12 -> Application/Storage -> Cookies -> cntt.vnpt.vn -> JSESSIONID
# Toolkit tự động map domain chuẩn và có cơ chế giãn cách request chống WAF rate-limit.
JIRA_COOKIE=

# 2. Hoặc dùng Personal Access Token (PAT) nếu hệ thống không bị MFA gateway chặn
JIRA_PAT=

# 3. Đăng nhập bằng Username / Password (chỉ dùng nếu server không bật MFA)
JIRA_USERNAME=tttruong
JIRA_PASSWORD=

# Bỏ qua cảnh báo chứng chỉ SSL nội bộ
IGNORE_SSL_WARNINGS=true
