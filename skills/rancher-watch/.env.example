# Rancher API — copy to .env (git-ignored)
RANCHER_URL=https://rancher.example.com
# Avatar -> Account & API Keys -> Create API Key (giới hạn cluster, đặt hạn dùng)
RANCHER_TOKEN=
# Hoặc tài khoản local provider (script tự đăng nhập lấy token 1 giờ rồi đăng xuất)
RANCHER_USER=
RANCHER_PASSWORD=
RANCHER_CLUSTER=local
RANCHER_NAMESPACE=ccdt-dev
# true nếu chứng chỉ tự ký
RANCHER_INSECURE=false
